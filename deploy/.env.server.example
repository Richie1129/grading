# 伺服器端 .env 範本（實際檔案只存在伺服器 /home/richie/grading/.env，權限 600，不進 git）
# 對應 deploy/docker-compose.server.yml；CI 只會改寫 IMAGE_TAG 這一行。
# 密碼類一律用 openssl rand -hex 32 產生，不沿用開發環境的值。

# ── CI 寫入 ─────────────────────────────────────────────
IMAGE_TAG=master

# ── 資料庫 / 快取 / 物件儲存（容器內部連線，主機埠只綁 127.0.0.1）──
POSTGRES_USER=grading
POSTGRES_PASSWORD=<openssl rand -hex 32>
POSTGRES_DB=grading_db
REDIS_PASSWORD=<openssl rand -hex 32>
MINIO_ACCESS_KEY=grading_admin
MINIO_SECRET_KEY=<openssl rand -hex 32>
MINIO_BUCKET=grading-files

# ── 認證 ────────────────────────────────────────────────
AUTH_SECRET=<openssl rand -hex 32>
INTERNAL_API_KEY=<openssl rand -hex 32>
GOOGLE_CLIENT_ID=<Google Cloud Console OAuth client>
GOOGLE_CLIENT_SECRET=<Google Cloud Console OAuth client>
# 必須與 Google Cloud Console 的 Authorized redirect URI 完全一致
GOOGLE_REDIRECT_URI=https://grading.wuretedu.com/auth/google/callback

# ── 對外網址 ────────────────────────────────────────────
APP_BASE_URL=https://grading.wuretedu.com
# Socket.IO CORS 白名單（逗號分隔）
ALLOWED_ORIGINS=https://grading.wuretedu.com

# ── AI 供應商 ───────────────────────────────────────────
GEMINI_API_KEY=<required>
GEMINI_API_KEY2=
GEMINI_API_KEY3=
OPENAI_API_KEY=
VLLM_BASE_URL=
VLLM_MODEL_NAME=
VLLM_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ── 評分行為（不填則用 compose 內的預設值，與原 prod-k3s configmap 相同）──
USE_AGENT_GRADING=true
AGENT_CONFIDENCE_THRESHOLD=0.7
CHAT_STUDENT_CONTENT_MAX_CHARS=3000
CHAT_REFERENCE_CONTENT_MAX_CHARS=20000
CHAT_REFERENCE_FILES_MAX_COUNT=5
CHAT_TOTAL_REFERENCE_MAX_CHARS=30000
PDF_PARSER_TIMEOUT_MS=30000
PDF_PARSER_RETRIES=2
LOG_LEVEL=info
PRISMA_LOG_LEVEL=error

# ── 首位管理員（docker compose run --rm --no-deps app npm run seed:admin）──
FIRST_ADMIN_EMAIL=

# ── Cloudflare Tunnel（Zero Trust 後台建立 tunnel 後取得 token）──
# 兩行都設好 cloudflared 才會啟動；沒有 token 前把 COMPOSE_PROFILES 留空
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=<Zero Trust tunnel token>
